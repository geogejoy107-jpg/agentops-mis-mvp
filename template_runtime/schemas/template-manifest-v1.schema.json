{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/template-manifest-v1.schema.json",
  "title": "AgentOps MIS TemplateManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "name", "version", "category", "description",
    "publisher", "license", "min_mis_version", "runtime_dependencies",
    "capabilities", "domain_objects", "workflows", "agents", "skills",
    "tools", "policies", "evaluators", "memory", "ui_extensions", "reports",
    "fixtures", "migrations", "permissions", "api_routes", "cli_commands",
    "testing_hooks", "exports", "upgrade_policy",
    "uninstall_policy", "provenance", "integrity"
  ],
  "properties": {
    "schema_version": {"const": "template-manifest/v1"},
    "id": {"$ref": "#/$defs/normalizedId"},
    "name": {"type": "string", "minLength": 1},
    "version": {"$ref": "#/$defs/semver"},
    "category": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "min_mis_version": {"$ref": "#/$defs/semver"},
    "runtime_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "version"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
          "kind": {"enum": ["python", "runtime", "template", "service"]},
          "version": {"type": "string", "pattern": "^(?:[~^]|==|>=|<=|>|<)?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:,(?:==|>=|<=|>|<)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?)*$"},
          "optional": {"type": "boolean"}
        }
      }
    },
    "capabilities": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}, "uniqueItems": true},
    "domain_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "authority"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*\\.domain\\.[a-z][a-z0-9_.-]*$"},
          "name": {"type": "string", "minLength": 1},
          "authority": {"enum": ["template_domain", "mis_core_reference"]},
          "core_authority_id": {"enum": [
            "mis_core.workspace", "mis_core.project", "mis_core.agent",
            "mis_core.task", "mis_core.plan", "mis_core.run",
            "mis_core.tool_call", "mis_core.prepared_action", "mis_core.approval",
            "mis_core.artifact", "mis_core.evaluation", "mis_core.memory_review",
            "mis_core.audit", "mis_core.evidence", "mis_core.project_delta",
            "mis_core.identity", "mis_core.permission"
          ]},
          "schema": {"type": "object"}
        },
        "allOf": [
          {"if": {"properties": {"authority": {"const": "template_domain"}}}, "then": {"required": ["id"]}},
          {"if": {"properties": {"authority": {"const": "mis_core_reference"}}}, "then": {"required": ["core_authority_id"]}}
        ]
      }
    },
    "workflows": {"$ref": "#/$defs/namespacedDeclarations"},
    "agents": {"$ref": "#/$defs/namespacedDeclarations"},
    "skills": {"$ref": "#/$defs/namespacedDeclarations"},
    "tools": {"$ref": "#/$defs/toolDeclarations"},
    "policies": {"$ref": "#/$defs/namespacedDeclarations"},
    "evaluators": {"$ref": "#/$defs/namespacedDeclarations"},
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_only", "source_refs_required", "shared_memory", "conflict_policy"],
      "properties": {
        "candidate_only": {"const": true},
        "source_refs_required": {"const": true},
        "shared_memory": {"const": "deny_by_default"},
        "conflict_policy": {"const": "stale_or_superseded"}
      }
    },
    "ui_extensions": {"$ref": "#/$defs/uiDeclarations"},
    "reports": {"$ref": "#/$defs/namespacedDeclarations"},
    "fixtures": {"$ref": "#/$defs/namespacedDeclarations"},
    "migrations": {"$ref": "#/$defs/migrationDeclarations"},
    "permissions": {"$ref": "#/$defs/permissionDeclarations"},
    "api_routes": {"$ref": "#/$defs/namespacedDeclarations"},
    "cli_commands": {"$ref": "#/$defs/namespacedDeclarations"},
    "testing_hooks": {"$ref": "#/$defs/namespacedDeclarations"},
    "exports": {"$ref": "#/$defs/namespacedDeclarations"},
    "upgrade_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview_required", "approval_required", "backup_required", "rollback_required", "readback_required", "receipt_required", "compatibility"],
      "properties": {
        "preview_required": {"const": true}, "approval_required": {"const": true},
        "backup_required": {"const": true}, "rollback_required": {"const": true},
        "readback_required": {"const": true}, "receipt_required": {"const": true},
        "compatibility": {"enum": ["semver", "explicit_matrix"]}
      }
    },
    "uninstall_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview_required", "approval_required", "readback_required", "receipt_required", "archive_history", "data_policy"],
      "properties": {
        "preview_required": {"const": true}, "approval_required": {"const": true},
        "readback_required": {"const": true}, "receipt_required": {"const": true},
        "archive_history": {"const": true},
        "data_policy": {"enum": ["archive", "delete_with_separate_approval"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_repository", "source_commit", "built_at"],
      "properties": {
        "source_repository": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "built_at": {"type": "string", "format": "date-time"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "content_sha256", "signature"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"enum": ["verified", "unsigned_candidate"]},
            "algorithm": {"enum": ["ed25519", "sigstore"]},
            "key_id": {"type": "string"},
            "value": {"type": "string"}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "verified"}}},
              "then": {"required": ["algorithm", "key_id", "value"]}
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "normalizedId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "namespacedDeclarations": {
      "type": "array",
      "items": {"allOf": [{"$ref": "#/$defs/declaration"}], "unevaluatedProperties": false}
    },
    "declaration": {
      "type": "object",
      "required": ["id", "version", "contract_version", "entrypoint"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9][a-z0-9_]*)+$"},
        "version": {"$ref": "#/$defs/semver"},
        "contract_version": {"type": "string", "minLength": 1},
        "entrypoint": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9][a-z0-9_]*)*(?::[a-z][a-z0-9_]*)?$"},
        "description": {"type": "string"},
        "configuration": {"type": "object"},
        "metadata": {"type": "object"}
      }
    },
    "toolDeclarations": {
      "type": "array",
      "items": {
        "unevaluatedProperties": false,
        "allOf": [
          {"$ref": "#/$defs/declaration"},
          {"type": "object", "required": ["risk", "side_effect", "approval"], "properties": {
            "risk": {"enum": ["low", "medium", "high", "critical"]},
            "side_effect": {"enum": ["none", "internal_write", "external_write"]},
            "approval": {"enum": ["never", "policy", "always"]}
          }, "allOf": [
            {"if": {"properties": {"side_effect": {"const": "external_write"}}, "required": ["side_effect"]}, "then": {"properties": {"approval": {"const": "always"}}}},
            {"if": {"properties": {"risk": {"const": "critical"}}, "required": ["risk"]}, "then": {"properties": {"approval": {"const": "always"}}}},
            {"if": {"properties": {"risk": {"const": "high"}}, "required": ["risk"]}, "then": {"properties": {"approval": {"enum": ["policy", "always"]}}}}
          ]}
        ]
      }
    },
    "migrationDeclarations": {
      "type": "array",
      "items": {
        "unevaluatedProperties": false,
        "allOf": [
          {"$ref": "#/$defs/declaration"},
          {"type": "object", "required": ["from_version", "to_version", "checksum", "reversible"], "properties": {
            "from_version": {"$ref": "#/$defs/semver"}, "to_version": {"$ref": "#/$defs/semver"},
            "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "reversible": {"type": "boolean"}
          }}
        ]
      }
    },
    "permissionDeclarations": {
      "type": "array",
      "items": {
        "unevaluatedProperties": false,
        "allOf": [
          {"$ref": "#/$defs/declaration"},
          {"type": "object", "required": ["action", "scope", "risk", "default"], "properties": {
            "action": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.permission\\.[a-z0-9][a-z0-9_]*(?:\\.[a-z0-9][a-z0-9_]*)*$"},
            "scope": {"enum": ["workspace", "template", "project", "run"]},
            "risk": {"enum": ["low", "medium", "high", "critical"]},
            "default": {"enum": ["allow", "ask", "deny"]}
          }, "allOf": [
            {"if": {"properties": {"risk": {"enum": ["high", "critical"]}}, "required": ["risk"]}, "then": {"properties": {"default": {"const": "deny"}}}},
            {"if": {"properties": {"risk": {"const": "medium"}}, "required": ["risk"]}, "then": {"properties": {"default": {"enum": ["ask", "deny"]}}}}
          ]}
        ]
      }
    },
    "uiDeclarations": {
      "type": "array",
      "items": {
        "unevaluatedProperties": false,
        "allOf": [
          {"$ref": "#/$defs/declaration"},
          {"type": "object", "required": ["route", "nav_label", "permission"], "properties": {
            "route": {"type": "string", "pattern": "^/solutions/[a-z][a-z0-9_]*/[a-z0-9_-]+(?:/[a-z0-9_-]+)*$"},
            "nav_label": {"type": "string", "minLength": 1},
            "permission": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.permission\\.[a-z0-9][a-z0-9_]*(?:\\.[a-z0-9][a-z0-9_]*)*$"}
          }}
        ]
      }
    }
  }
}
