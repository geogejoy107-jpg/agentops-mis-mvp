AGENTOPS_IMAGE=agentops-mis-byoc:local
AGENTOPS_BIND_ADDRESS=127.0.0.1
AGENTOPS_PORT=3001
AGENTOPS_ALLOWED_ORIGINS=https://mis.example.com
AGENTOPS_ENTITLEMENT_CONTROL_PLANE_URL=https://mis.example.com
AGENTOPS_ENTITLEMENT_CONTROL_PLANE_ORIGIN=https://mis.example.com
AGENTOPS_ENTITLEMENT_OPERATOR_USERNAME=owner
AGENTOPS_POSTGRES_DATABASE=agentops
AGENTOPS_POSTGRES_MIGRATOR_USER=agentops_migrator
AGENTOPS_POSTGRES_RUNTIME_USER=agentops_runtime
AGENTOPS_POSTGRES_ENTITLEMENT_ADMIN_USER=agentops_entitlement_admin
AGENTOPS_POSTGRES_MIGRATOR_PASSWORD_FILE=./secrets/postgres-migrator-password
AGENTOPS_POSTGRES_RUNTIME_PASSWORD_FILE=./secrets/postgres-runtime-password
AGENTOPS_POSTGRES_ENTITLEMENT_ADMIN_PASSWORD_FILE=./secrets/postgres-entitlement-admin-password
AGENTOPS_ENTITLEMENT_OPERATOR_PASSWORD_FILE=./secrets/entitlement-operator-password
AGENTOPS_HUMAN_SESSION_HMAC_KEY_FILE=./secrets/human-session-hmac-key
AGENTOPS_WORKER_CONTROL_PLANE_URL=https://mis.example.com
AGENTOPS_WORKER_WORKSPACE_ID=ws_customer
AGENTOPS_WORKER_ESTIMATED_COST_USD=1.000000
AGENTOPS_WORKER_POLL_INTERVAL_MS=5000
AGENTOPS_WORKER_ADAPTER_MAX_ATTEMPTS=2
AGENTOPS_WORKER_HEALTH_LEASE_SECONDS=120
AGENTOPS_WORKER_ALLOW_HIGH_RISK=false
AGENTOPS_HERMES_WORKER_AGENT_ID=agt_customer_hermes
AGENTOPS_HERMES_WORKER_AGENT_TOKEN_FILE=./secrets/hermes-worker-agent-token
AGENTOPS_HERMES_GATEWAY_URL=https://hermes.example.com
AGENTOPS_HERMES_MODEL=hermes-agent
AGENTOPS_HERMES_TIMEOUT_MS=180000
AGENTOPS_HERMES_MAX_TOKENS=512
AGENTOPS_OPENCLAW_WORKER_AGENT_ID=agt_customer_openclaw
AGENTOPS_OPENCLAW_WORKER_AGENT_TOKEN_FILE=./secrets/openclaw-worker-agent-token
AGENTOPS_OPENCLAW_CONFIG_FILE=./secrets/openclaw-config.json
AGENTOPS_OPENCLAW_RUNTIME_PATH=./openclaw-runtime
AGENTOPS_OPENCLAW_PROVIDER_BIN=/opt/agentops-provider/openclaw/bin/openclaw
AGENTOPS_OPENCLAW_AGENT=main
AGENTOPS_OPENCLAW_TIMEOUT_SECONDS=180
AGENTOPS_OPENCLAW_WORKSPACE_PATH=./worker-workspace
